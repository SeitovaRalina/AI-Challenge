LITELLM_API_KEY=
LITELLM_MODEL=
# Optional, defaults to https://llm.effective.land
LITELLM_BASE_URL=
# Optional, defaults to 8080
PORT=
# Optional, defaults to http://localhost:5173 (the Vite dev server)
CORS_ALLOWED_ORIGIN=
# Optional, defaults to 128000. Token budget the chat agent measures its
# context-usage bar against and refuses to exceed with another LLM call.
# Lower it (e.g. 2000) to reliably demo context overflow in a short dialog.
CHAT_CONTEXT_TOKEN_LIMIT=
# Optional, defaults to 10. How many of the most recent messages a chat keeps
# "as is" once history compression is due; everything older is folded into a
# rolling summary instead of being resent every turn.
HISTORY_KEEP_LAST_N=
# Optional, defaults to true. Whether new chats start with history
# compression on. It's also a live per-chat toggle in the UI, changeable
# mid-conversation without restarting the backend.
HISTORY_COMPRESSION_ENABLED=
