LITELLM_API_KEY=
LITELLM_MODEL=
# Optional, defaults to https://llm.effective.land
LITELLM_BASE_URL=
# Optional, defaults to 8080
PORT=
# Optional, defaults to http://localhost:5173 (the Vite dev server)
CORS_ALLOWED_ORIGIN=
# Optional, defaults to 128000. Token budget the chat agent measures its
# context-usage bar against and refuses to exceed with another LLM call.
# Lower it (e.g. 2000) to reliably demo context overflow in a short dialog.
CHAT_CONTEXT_TOKEN_LIMIT=
# Optional, defaults to 10. How many of the most recent messages
# sliding_window/sticky_facts resend on every turn, and how many
# rolling_summary keeps "as is" once compression is due (everything older is
# folded into a rolling summary instead of being resent every turn).
HISTORY_KEEP_LAST_N=
# Optional, defaults to sliding_window. Which context strategy a new (non-lab)
# chat starts on: sliding_window, sticky_facts, branching, or rolling_summary.
# It's also a live per-chat dropdown in the UI, changeable mid-conversation
# without restarting the backend.
CONTEXT_STRATEGY_DEFAULT=
# Required for the «Источники» screen / go run ./cmd/mcp-tools (day 16).
# Fine-grained GitHub personal access token, read-only (Metadata, Contents,
# Pull requests, Issues). Sent only to the GitHub MCP server, never to the
# browser.
GITHUB_TOKEN=
# Optional, defaults to https://api.githubcopilot.com/mcp/ (GitHub's official
# remote MCP server).
GITHUB_MCP_URL=
# Optional (day 17). Comma-separated owner/repo list the own GitHub Activity
# MCP server (cmd/mcp-github) collects activity from. Empty = every
# repository the token can see.
GITHUB_REPOS=
# Optional (day 17). Command line that starts the GitHub Activity MCP server
# over stdio. Defaults to "go run ./cmd/mcp-github" (run the backend from
# backend/); point it at a prebuilt binary to skip the go toolchain.
MCP_GITHUB_COMMAND=
# Optional (day 18). How often the background collector runs the chain
# github.get_activity -> worklog.ingest_events -> worklog.get_activity_digest.
# A Go duration ("15m", "1h"), defaults to 15m; "0" or "off" disables the
# schedule (manual runs via the «Активность» screen still work).
COLLECT_INTERVAL=
# Optional (day 18). SQLite file the Worklog MCP server (cmd/mcp-worklog)
# stores collected activity in. Defaults to <data dir>/worklog.db, next to
# the chat sessions.
WORKLOG_DB=
# Optional (day 18). Command line that starts the Worklog MCP server over
# stdio. Defaults to "go run ./cmd/mcp-worklog"; point it at a prebuilt
# binary to skip the go toolchain.
MCP_WORKLOG_COMMAND=
# Required for the Calendar MCP server (day 20) — without both, calendar
# collection and the calendar chat/orchestration tools are simply skipped,
# GitHub-only collection keeps working. CalDAV login (usually your email)
# and an app-specific password (Yandex: id.yandex.ru -> security -> app
# passwords -> CalDAV), never your account password.
CALDAV_USERNAME=
CALDAV_APP_PASSWORD=
# Optional (day 20), defaults to https://caldav.yandex.ru.
CALDAV_URL=
# Optional (day 20). Comma-separated calendar names to collect from. Empty =
# every calendar on the account.
CALDAV_CALENDARS=
# Optional (day 20). Command line that starts the Calendar MCP server over
# stdio. Defaults to "go run ./cmd/mcp-calendar"; point it at a prebuilt
# binary to skip the go toolchain.
MCP_CALENDAR_COMMAND=
# Optional (day 21), defaults to http://localhost:11434. Local Ollama
# instance used ONLY for RAG embeddings — the company LiteLLM gateway has no
# embedding model configured for this product's key, verified directly
# (GET /v1/models lists chat models only; POST /v1/embeddings 400s with
# "Invalid model name"). Install: https://ollama.com, then `ollama serve`.
OLLAMA_URL=
# Required for the «Похожие задачи» screen (day 21) reindex to work. Name of
# an embedding model pulled into Ollama, e.g. `ollama pull nomic-embed-text`
# then OLLAMA_EMBED_MODEL=nomic-embed-text. Chat completions (rerank, query
# rewrite, the final RAG answer) still go through LITELLM_MODEL above.
OLLAMA_EMBED_MODEL=
