LITELLM_API_KEY=
LITELLM_MODEL=
# Optional, defaults to https://llm.effective.land
LITELLM_BASE_URL=
# Optional, defaults to 8080
PORT=
# Optional, defaults to http://localhost:5173 (the Vite dev server)
CORS_ALLOWED_ORIGIN=
# Optional, defaults to 128000. Token budget the chat agent measures its
# context-usage bar against and refuses to exceed with another LLM call.
# Lower it (e.g. 2000) to reliably demo context overflow in a short dialog.
CHAT_CONTEXT_TOKEN_LIMIT=
# Optional, defaults to 10. How many of the most recent messages
# sliding_window/sticky_facts resend on every turn, and how many
# rolling_summary keeps "as is" once compression is due (everything older is
# folded into a rolling summary instead of being resent every turn).
HISTORY_KEEP_LAST_N=
# Optional, defaults to sliding_window. Which context strategy a new (non-lab)
# chat starts on: sliding_window, sticky_facts, branching, or rolling_summary.
# It's also a live per-chat dropdown in the UI, changeable mid-conversation
# without restarting the backend.
CONTEXT_STRATEGY_DEFAULT=
